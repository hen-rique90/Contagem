{
  "name": "balanco-estoque",
  "private": true,
  "version": "1.0.0",
  "description": "Balanço de estoque por código de barras (leitor pistola ou câmera) — PWA para Android",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/app.css --watch",
    "serve": "npx --yes http-server@14.1.1 public -p 8080 -c-1"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
